{
  "schemaVersion": 1,
  "profile": "bootstrap",
  "modules": {
    "backend": {
      "path": "dau-viet-backend",
      "status": "active",
      "manifests": [
        "pom.xml",
        "mvnw.cmd",
        "docker-compose.yml"
      ],
      "gates": [
        {
          "id": "backend-compile",
          "executable": "cmd.exe",
          "args": ["/c", "set JAVA_HOME=E:\\Java\\jdk-21&& mvnw.cmd -q -DskipTests compile"],
          "cwd": "dau-viet-backend",
          "timeoutSeconds": 300
        },
        {
          "id": "backend-test",
          "executable": "cmd.exe",
          "args": ["/c", "set JAVA_HOME=E:\\Java\\jdk-21&& mvnw.cmd -q verify"],
          "cwd": "dau-viet-backend",
          "timeoutSeconds": 600
        }
      ]
    },
    "admin": {
      "path": "dau-viet-admin",
      "status": "uninitialized",
      "manifests": [
        "package.json"
      ],
      "gates": []
    },
    "mobile": {
      "path": "dau-viet-mobile",
      "status": "active",
      "manifests": [
        "pubspec.yaml"
      ],
      "gates": [
        {
          "id": "mobile-analyze",
          "executable": "flutter",
          "args": ["analyze"],
          "cwd": "dau-viet-mobile",
          "timeoutSeconds": 120
        },
        {
          "id": "mobile-test",
          "executable": "flutter",
          "args": ["test"],
          "cwd": "dau-viet-mobile",
          "timeoutSeconds": 120
        }
      ]
    }
  },
  "gates": [],
  "policy": {
    "maxRepairAttempts": 3,
    "requireIndependentReview": true,
    "requireHandoff": true
  },
  "gitnexus": {
    "enabled": false,
    "version": null,
    "fallback": "targeted-search"
  },
  "runner": {
    "entrypoint": "scripts/harness/harness.ps1",
    "shell": "pwsh",
    "args": [
      "-NoProfile",
      "-File"
    ],
    "timeoutSeconds": 600,
    "cwdAllowlist": [
      "."
    ],
    "note": "Requires PowerShell 7 (pwsh). On machines with only Windows PowerShell 5.1 the runner fails fast via #requires directive."
  }
}